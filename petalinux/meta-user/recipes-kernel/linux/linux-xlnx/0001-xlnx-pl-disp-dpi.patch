+
+static inline struct xlnx_pl_disp *connector_to_dma(struct drm_connector *connector)
+{
+	return container_of(connector, struct xlnx_pl_disp, connector);
+}
+
+static int xlnx_pl_disp_connector_get_modes(struct drm_connector *connector)
+{
+	struct xlnx_pl_disp *xlnx_pl_disp = connector_to_dma(connector);
+	struct drm_display_mode *mode;
+
+	if (!xlnx_pl_disp->mode_valid)
+		return 0;
+
+	mode = drm_mode_duplicate(connector->dev, &xlnx_pl_disp->mode);
+	if (!mode)
+		return 0;
+
+	drm_mode_probed_add(connector, mode);
+	return 1;
+}
+
+static enum drm_connector_status
+xlnx_pl_disp_connector_detect(struct drm_connector *connector, bool force)
+{
+	return connector_status_connected;
+}
+
+static const struct drm_connector_helper_funcs
+xlnx_pl_disp_connector_helper_funcs = {
+	.get_modes = xlnx_pl_disp_connector_get_modes,
+};
+
+static const struct drm_connector_funcs xlnx_pl_disp_connector_funcs = {
+	.detect = xlnx_pl_disp_connector_detect,
+	.fill_modes = drm_helper_probe_single_connector_modes,
+	.destroy = drm_connector_cleanup,
+	.reset = drm_atomic_helper_connector_reset,
+	.atomic_duplicate_state = drm_atomic_helper_connector_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_connector_destroy_state,
+};
+
+static const struct drm_encoder_funcs xlnx_pl_disp_encoder_funcs = {
+	.destroy = drm_encoder_cleanup,
+};
+
+static int xlnx_pl_disp_parse_mode(struct device *dev,
+					struct xlnx_pl_disp *xlnx_pl_disp)
+{
+	struct device_node *endpoint, *panel;
+	struct display_timing timing;
+	struct videomode vm;
+
+	endpoint = of_graph_get_next_endpoint(dev->of_node, NULL);
+	if (!endpoint)
+		return -ENODEV;
+
+	panel = of_graph_get_remote_port_parent(endpoint);
+	of_node_put(endpoint);
+	if (!panel)
+		return -ENODEV;
+
+	of_get_display_timing(panel, "panel-timing", &timing);
+	of_node_put(panel);
+	videomode_from_timing(&timing, &vm);
+
+	drm_display_mode_from_videomode(&vm, &xlnx_pl_disp->mode);
+	xlnx_pl_disp->mode.type = DRM_MODE_TYPE_DRIVER |
+		DRM_MODE_TYPE_PREFERRED;
+	xlnx_pl_disp->mode_valid = true;
+	return 0;
+}
+
+static int xlnx_pl_disp_register_connector(struct drm_device *drm,
+						struct xlnx_pl_disp *xlnx_pl_disp)
+{
+	int ret;
+
+	ret = drm_encoder_init(drm, &xlnx_pl_disp->encoder,
+				       &xlnx_pl_disp_encoder_funcs,
+				       DRM_MODE_ENCODER_DPI, NULL);
+	if (ret)
+		return ret;
+
+	xlnx_pl_disp->encoder.possible_crtcs = 1;
+	ret = drm_connector_init(drm, &xlnx_pl_disp->connector,
+					&xlnx_pl_disp_connector_funcs,
+					DRM_MODE_CONNECTOR_DPI);
+	if (ret) {
+		drm_encoder_cleanup(&xlnx_pl_disp->encoder);
+		return ret;
+	}
+
+	drm_connector_helper_add(&xlnx_pl_disp->connector,
+					 &xlnx_pl_disp_connector_helper_funcs);
+	drm_connector_attach_encoder(&xlnx_pl_disp->connector,
+					     &xlnx_pl_disp->encoder);
+	return 0;
+}
